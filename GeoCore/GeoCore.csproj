<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!--
      CA1510 suggests ArgumentNullException.ThrowIfNull, which does not exist on
      netstandard2.0. The explicit throws are shared across both targets.
    -->
    <NoWarn>$(NoWarn);CA1510</NoWarn>
  </PropertyGroup>

  <!-- NuGet package metadata -->
  <PropertyGroup>
    <PackageId>GeoCore</PackageId>
    <Version>0.2.0</Version>
    <Authors>Rowan Richards</Authors>
    <Description>A clean, modern, dependency-light .NET library for geospatial maths: great-circle and ellipsoidal (Vincenty) distance, bearings, rhumb lines, cross-track/along-track distance, polygons with holes, routes, bounding boxes, circles, unit conversion, and GeoJSON/WKT/geohash/encoded-polyline interop.</Description>
    <PackageTags>geo;geospatial;gis;geography;latitude;longitude;haversine;vincenty;great-circle;distance;bearing;geohash;geojson;wkt;polyline</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/RwnRchrds/GeoCore</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/RwnRchrds/GeoCore</PackageProjectUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

  <!-- System.Text.Json ships in-box from net8.0 onwards. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

</Project>
